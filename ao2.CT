<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="52">
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"AO Tennis 2 - Carreira Editor"</Description>
      <Options moHideChildren="1"/>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : ao2.exe
  Version:
  Date   : 2026-08-10
  Author : lucas
  Description : AO Tennis 2 - Athlete Attributes
}

[ENABLE]

aobscanmodule(INJECT,ao2.exe,44 88 44 01 03) // should be unique
alloc(newmem,$1000,INJECT)
alloc(PLAYER_STATS,8)

label(code)
label(capture)
label(return)

registersymbol(INJECT)
registersymbol(PLAYER_STATS)

newmem:

capture:
  cmp rax,02
  jne code

  mov [PLAYER_STATS],rcx
  add qword ptr [PLAYER_STATS],05

code:
  mov [rcx+rax+03],r8b
  add rsp,08
  jmp return

INJECT:
  jmp newmem
  nop 4
return:

[DISABLE]

INJECT:
  db 44 88 44 01 03 48 83 C4 08

unregistersymbol(INJECT)
unregistersymbol(PLAYER_STATS)

dealloc(PLAYER_STATS)
dealloc(newmem)
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>53</ID>
          <Description>"MASTER (Necessário Ativar)"</Description>
          <Options moHideChildren="1"/>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]

aobscanmodule(INJECT_CAREER,ao2.exe,8B 81 0C 02 00 00 C3 CC)
alloc(newmem,$1000,INJECT_CAREER)
alloc(PLAYER_CAREER,8)

label(return)

newmem:
  mov [PLAYER_CAREER],rcx
  mov eax,[rcx+0000020C]
  jmp return

INJECT_CAREER:
  jmp newmem
  nop

return:

registersymbol(INJECT_CAREER)
registersymbol(PLAYER_CAREER)

[DISABLE]

INJECT_CAREER:
  db 8B 81 0C 02 00 00

unregistersymbol(INJECT_CAREER)
unregistersymbol(PLAYER_CAREER)

dealloc(PLAYER_CAREER)
dealloc(newmem)
</AssemblerScript>
